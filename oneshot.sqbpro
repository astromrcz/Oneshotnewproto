mns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="101"/><column index="3" value="102"/><column index="4" value="39"/><column index="5" value="107"/><column index="6" value="62"/><column index="7" value="95"/><column index="8" value="68"/><column index="9" value="56"/><column index="10" value="44"/><column index="11" value="86"/><column index="12" value="147"/><column index="13" value="127"/><column index="14" value="83"/><column index="15" value="98"/><column index="16" value="107"/><column index="17" value="82"/><column index="18" value="98"/><column index="19" value="122"/><column index="20" value="71"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="session_orders" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="69"/><column index="3" value="82"/><column index="4" value="35"/><column index="5" value="88"/><column index="6" value="72"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="tables" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="40"/><column index="3" value="44"/><column index="4" value="59"/><column index="5" value="128"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ==========================================
-- ONE SHOT BAR &amp; BILLIARDS: MASTER SQLITE SCHEMA
-- ==========================================

-- 1. AUTHENTICATION &amp; USERS
CREATE TABLE users (
    id TEXT PRIMARY KEY,
    username TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    full_name TEXT NOT NULL,
    email TEXT UNIQUE,
    role TEXT NOT NULL CHECK(role IN ('manager', 'cashier', 'admin')),
    phone TEXT,
    is_active BOOLEAN DEFAULT 1,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. DYNAMIC CONTENT MANAGEMENT (CMS)
-- For Hero Sliders, Announcements, and About Us text
CREATE TABLE cms_content (
    key_name TEXT PRIMARY KEY, -- e.g., 'hero_slide_1', 'about_us_text'
    content_value TEXT NOT NULL,
    content_type TEXT NOT NULL CHECK(content_type IN ('text', 'image_url', 'json')),
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 3. SYSTEM SETTINGS &amp; RATES
CREATE TABLE system_settings (
    key_name TEXT PRIMARY KEY, -- e.g., 'hourly_rate', 'happy_hour_start'
    setting_value TEXT NOT NULL,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Insert Default Rates automatically
INSERT INTO system_settings (key_name, setting_value) VALUES 
('hourly_rate', '250'),
('happy_hour_rate', '200'),
('happy_hour_start', '18:00'),
('happy_hour_end', '19:00'),
('is_happy_hour_active', '1'),
('down_payment_percent', '25'),
('reservation_start_time', '12:00'),
('reservation_end_time', '02:00');

-- 4. BILLIARD TABLES
CREATE TABLE tables (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    status TEXT NOT NULL CHECK(status IN ('available', 'occupied', 'reserved', 'maintenance')),
    is_active BOOLEAN DEFAULT 1,
    maintenance_reason TEXT
);

-- 5. INVENTORY &amp; MENU
CREATE TABLE inventory (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL CHECK(category IN ('Drinks', 'Food', 'Extras')),
    price REAL NOT NULL,
    stock INTEGER NOT NULL DEFAULT 0,
    is_active BOOLEAN DEFAULT 1,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 6. PROMO CODES
CREATE TABLE promo_codes (
    id TEXT PRIMARY KEY,
    code TEXT UNIQUE NOT NULL,
    discount_percent REAL NOT NULL,
    description TEXT,
    is_active BOOLEAN DEFAULT 1,
    is_limited_uses BOOLEAN DEFAULT 0,
    max_usage INTEGER DEFAULT 0,
    usage_count INTEGER DEFAULT 0,
    start_date DATETIME,
    expires_at DATETIME,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 7. CUSTOMER RESERVATIONS
CREATE TABLE reservations (
    id TEXT PRIMARY KEY,
    customer_name TEXT NOT NULL,
    contact_number TEXT NOT NULL,
    email TEXT,
    reservation_date DATE NOT NULL,
    time_slot TEXT NOT NULL,
    duration_hours INTEGER NOT NULL,
    party_size INTEGER NOT NULL,
    table_id TEXT,
    status TEXT NOT NULL CHECK(status IN ('pending', 'confirmed', 'checked-in', 'completed', 'cancelled')),
    total_amount REAL NOT NULL,
    down_payment_amount REAL NOT NULL,
    down_payment_paid BOOLEAN DEFAULT 0,
    balance_paid BOOLEAN DEFAULT 0,
    promo_code_id TEXT,
    discount_amount REAL DEFAULT 0,
    payment_ref TEXT,
    receipt_img_url TEXT,
    cancellation_reason TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (table_id) REFERENCES tables(id),
    FOREIGN KEY (promo_code_id) REFERENCES promo_codes(id)
);

-- 8. WALK-IN QUEUE
CREATE TABLE queue (
    id TEXT PRIMARY KEY,
    customer_name TEXT NOT NULL,
    contact_number TEXT NOT NULL,
    party_size INTEGER NOT NULL,
    notes TEXT,
    status TEXT NOT NULL CHECK(status IN ('waiting', 'called', 'seated', 'cancelled')),
    queue_number INTEGER NOT NULL,
    arrival_time DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 9. ACTIVE TABLE SESSIONS (The core of the POS/Timer)
CREATE TABLE sessions (
    id TEXT PRIMARY KEY,
    table_id TEXT NOT NULL,
    customer_name TEXT NOT NULL,
    start_time DATETIME NOT NULL,
    duration_minutes INTEGER, -- NULL means &quot;Open Time&quot;
    is_open_time BOOLEAN DEFAULT 0,
    is_paid BOOLEAN DEFAULT 0,
    hourly_rate REAL NOT NULL,
    amount_paid REAL DEFAULT 0,
    payment_status TEXT CHECK(payment_status IN ('paid', 'payLater')),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (table_id) REFERENCES tables(id)
);

-- 10. SESSION ORDERS (The POS items attached to a playing table)
CREATE TABLE session_orders (
    id TEXT PRIMARY KEY,
    session_id TEXT NOT NULL,
    inventory_id TEXT NOT NULL,
    qty INTEGER NOT NULL,
    price_at_time REAL NOT NULL,
    ordered_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (session_id) REFERENCES sessions(id) ON DELETE CASCADE,
    FOREIGN KEY (inventory_id) REFERENCES inventory(id)
);

-- 11. EVENTS &amp; HOLIDAYS
CREATE TABLE events (
    id TEXT PRIMARY KEY,
    title TEXT NOT NULL,
    event_date DATE NOT NULL,
    type TEXT NOT NULL CHECK(type IN ('Tournament', 'League', 'Holiday', 'Other')),
    description TEXT,
    registration_link TEXT,
    max_participants INTEGER,
    slots_full BOOLEAN DEFAULT 0,
    image_url TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 12. CALENDAR CLOSURES (Days the shop is closed)
CREATE TABLE closed_dates (
    id TEXT PRIMARY KEY,
    closed_date DATE NOT NULL,
    reason TEXT NOT NULL,
    is_full_day BOOLEAN DEFAULT 1,
    open_time TEXT,
    close_time TEXT
);

-- 13. CUSTOMER FEEDBACK
CREATE TABLE feedback (
    id TEXT PRIMARY KEY,
    customer_name TEXT NOT NULL,
    contact_info TEXT,
    feedback_type TEXT NOT NULL CHECK(feedback_type IN ('suggestion', 'complaint', 'lost_item', 'compliment', 'other')),
    comment TEXT NOT NULL,
    reservation_id TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (reservation_id) REFERENCES reservations(id)
);

-- 14. ACTIVITY &amp; AUDIT LOGS (For Admin Tracking)
CREATE TABLE activity_logs (
    id TEXT PRIMARY KEY,
    user_id TEXT, -- Can be null if system generated
    activity_type TEXT NOT NULL,
    description TEXT NOT NULL,
    metadata_json TEXT, -- Store extra details as JSON string
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id)
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
