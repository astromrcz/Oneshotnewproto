schema="main" name="reservations" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="8" mode="0"/></sort><column_widths><column index="1" value="63"/><column index="2" value="111"/><column index="3" value="95"/><column index="4" value="143"/><column index="5" value="87"/><column index="6" value="56"/><column index="7" value="89"/><column index="8" value="62"/><column index="9" value="49"/><column index="10" value="79"/><column index="11" value="80"/><column index="12" value="134"/><column index="13" value="113"/><column index="14" value="76"/><column index="15" value="73"/><column index="16" value="101"/><column index="17" value="78"/><column index="18" value="71"/><column index="19" value="118"/><column index="20" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Forcefully delete the old, outdated table
DROP TABLE IF EXISTS feedback;

-- 2. Create the new table matching React's camelCase perfectly
CREATE TABLE feedback (
    id TEXT PRIMARY KEY,
    customerName TEXT NOT NULL,
    contactInfo TEXT,
    feedbackType TEXT NOT NULL,
    comment TEXT NOT NULL,
    reservationId TEXT,
    tags TEXT, -- Stored as a JSON array string
    date DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 3. Insert the seed data using the exact camelCase column names
INSERT INTO feedback (id, customerName, contactInfo, feedbackType, comment, tags, date) VALUES 
('f1', 'Mark Reyes', '0917-000-1111', 'compliment', 'The tables are perfectly leveled. Best billiard hall in Cainta!', '[&quot;clean tables&quot;, &quot;good ambiance&quot;]', datetime('now', '-2 hours')),
('f2', 'Sarah Gomez', 'sarah.g@gmail.com', 'suggestion', 'Can you add more chairs near Table 4? We had to stand while waiting.', '[&quot;wait time&quot;, &quot;friendly staff&quot;]', datetime('now', '-1 day')),
('f3', 'John Doe', '0918-222-3333', 'complaint', 'The aircon near table 8 wasn''t cold enough.', '[&quot;peak hours&quot;]', datetime('now', '-2 days')),
('f4', 'Mike Santos', 'mike@test.com', 'lost_item', 'I left my custom cue stick chalk near table 2. Has anyone surrendered it to the counter?', '[]', datetime('now', '-3 days')),
('f5', 'Lisa Manoban', '0999-888-7777', 'compliment', 'Love the automated timer system and happy hour prices!', '[&quot;timer system&quot;, &quot;fair price&quot;]', datetime('now', '-4 days')),
('f6', 'Ben Cruz', 'ben@cruz.com', 'suggestion', 'Would be nice if you sold heavier cue sticks for break shots.', '[]', datetime('now', '-5 days')),
('f7', 'Anna Lim', '0919-555-4444', 'compliment', 'Very organized queueing system. Didn''t feel like we were ignored even when it was full.', '[&quot;organized queue&quot;, &quot;fast service&quot;]', datetime('now', '-6 days'));</sql><current_tab id="0"/></tab_sql></sqlb_project>
