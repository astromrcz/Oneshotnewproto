    keyName TEXT PRIMARY KEY,
    settingValue TEXT NOT NULL,
    updatedAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO cms (keyName, settingValue) VALUES 
('heroTitle', 'One Shot'),
('heroSubtitle', 'Bar &amp; Billiards'),
('heroDescription', 'Your premier billiard destination at Autobase OAX, Cainta, Rizal. 10 world-class tables, refreshing drinks, and an unbeatable atmosphere.'),
('aboutTitle', 'A Passion for the Game'),
('aboutP1', 'One Shot Bar &amp; Billiards was founded with a simple mission: to create the ultimate billiard experience in Cainta, Rizal. What started as a small hobby shop has grown into the premier billiards destination in Eastern Rizal.'),
('aboutP2', 'Our 10 tournament-grade tables are maintained with precision, and our staff are passionate players themselves who understand what makes a great game environment.'),
('aboutP3', 'Whether you''re a seasoned champion or picking up a cue for the first time, One Shot welcomes you. Come in, relax, and take your shot!'),
